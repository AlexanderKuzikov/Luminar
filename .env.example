# Luminar — переменные окружения
# Скопируй этот файл в .env и заполни значения
# .env никогда не коммитится в git

# ─── Ключи провайдеров ────────────────────────────────────────────────────────
# Формат: {PROVIDER_ID}_{KEY_ID} (все буквы заглавные)
# Соответствует полю envVar в config.json → providers[].keys[]

# VseLLM / LM Studio
VSELLM_KEY_1=
# VSELLM_KEY_2=

# OpenAI (пример дополнительного провайдера)
# OPENAI_KEY_1=
# OPENAI_KEY_2=

# ─── Опциональные настройки ───────────────────────────────────────────────────
# DATA_DIR=           # Переопределить путь к data/ директории
