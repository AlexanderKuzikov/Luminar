# Luminar — environment variables example
# Copy to .env and fill in your values.
# This file is safe to commit. .env is NOT.

# Optional: override the port (default: auto-detect from 3000)
# LUMINAR_PORT=3000

# Optional: override the data directory path
# Default: ./data (relative to process.cwd())
# LUMINAR_DATA_DIR=C:\Users\you\AppData\Local\Luminar\data

# Optional: disable auto-open browser on start
# LUMINAR_NO_BROWSER=1
